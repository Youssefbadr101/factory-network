# Password required to reach /admin and add/edit/delete factories.
# Everyone else only ever gets read access to the public directory.
ADMIN_PASSWORD=change-me

# A Postgres database (any Supabase project works) with a
# `factory_network_listings` table — see the migration SQL in this repo's
# history, or create your own with the same shape. The service-role key is
# used server-side only (Server Components / Server Actions) and is never
# sent to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
